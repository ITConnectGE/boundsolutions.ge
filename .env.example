# Base URL of the Laravel API (see backend/). When set, the frontend can talk to
# the backend instead of the localStorage demo. Leave unset to keep demo mode.
# Local dev:  http://127.0.0.1:8000/api
# Production: https://api.boundsolutions.ge/api  (your PHP/MySQL host)
VITE_API_BASE=

# Web3Forms access key — emails contact/CV/employer submissions. Get one free at
# https://web3forms.com. Client-side key (safe to expose). Empty = email off.
VITE_WEB3FORMS_KEY=
