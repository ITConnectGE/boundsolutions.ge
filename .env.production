# Production build: the API is served on the same domain at /api (see deploy/).
# Committed so every server build talks to the DB-backed API (not the demo).
VITE_API_BASE=/api

# Web3Forms access key for emailing form submissions (contact + CV + employer).
# It's a client-side key (safe to commit). Get one at https://web3forms.com.
# Leave empty to disable email (submissions still save to the admin inbox).
VITE_WEB3FORMS_KEY=
